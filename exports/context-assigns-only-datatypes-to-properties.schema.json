{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/context-assigns-only-datatypes-to-properties.schema.json",
    "title": "Context assigns only datatypes to properties",
    "description": "Every object the @context gives for a property holds at most a @type, the datatype of the property's values, and nothing else: no @reverse, @language, @direction, @nest, @prefix, @index, or any other member. An @id there is an alias, which context-aliases-absent reports, so this expectation is assessed only once that one is met.",
    "summary": "The only thing the `@context` assigns to a property is the datatype of its values",
    "requires": [
        "context-aliases-absent"
    ],
    "$defs": {
        "propertyObject": {
            "if": { "type": "object" },
            "then": {
                "properties": {
                    "@id": true,
                    "@type": true
                },
                "additionalProperties": false,
                "errorMessage": {
                    "additionalProperties": "the @context assigns nothing to a property but the datatype of its values"
                }
            }
        },
        "context": {
            "if": { "type": "object" },
            "then": {
                "properties": { "@base": true },
                "additionalProperties": { "$ref": "#/$defs/propertyObject" }
            },
            "else": {
                "if": { "type": "array" },
                "then": { "items": { "$ref": "#/$defs/context" } }
            }
        },
        "node": {
            "if": { "type": "object" },
            "then": {
                "properties": { "@context": { "$ref": "#/$defs/context" } },
                "additionalProperties": { "$ref": "#/$defs/node" }
            },
            "else": {
                "if": { "type": "array" },
                "then": { "items": { "$ref": "#/$defs/node" } }
            }
        }
    },
    "$ref": "#/$defs/node"
}
