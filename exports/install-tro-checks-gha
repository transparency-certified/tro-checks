#!/usr/bin/env bash
#
# Copies tro-checks' GitHub Actions workflows into the repository mounted at REPRO_MNT: workflows 1-3
# always, and 4 or 5 when the repository already has it or its number is given, e.g.
#
#     install-tro-checks-gha 4 5
#
# Overwrites earlier copies, so running it again is the upgrade; git shows what changed. Each copy
# records the tro-checks version it came from.

set -euo pipefail

read -r _ version install_dir < "${REPRO_INDEX_DIR}/tro-checks"
originals=${install_dir}/gha
workflows=${REPRO_MNT}/.github/workflows

mkdir -p "${workflows}"
for original in "${originals}"/workflows/*.yml; do
    name=$(basename "${original}")
    number=${name%%-*}
    case " 1 2 3 $* " in
        *" ${number} "*) ;;
        *) [[ -f ${workflows}/${name} ]] || continue ;;
    esac
    sed "s/TRO_CHECKS_VERSION/${version}/" "${original}" > "${workflows}/${name}"
    echo "Installed .github/workflows/${name}"
done

if [[ -d ${originals}/actions ]]; then
    mkdir -p "${REPRO_MNT}/.github/actions"
    cp -r "${originals}/actions/." "${REPRO_MNT}/.github/actions/"
    echo "Installed .github/actions/"
fi
