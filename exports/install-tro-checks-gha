#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob

always="preview-pasted-declaration preview-one-candidate regenerate-reports"

read -r _ _ install_dir < "${REPRO_INDEX_DIR}/tro-checks"
originals=${install_dir}/gha
workflows=${REPRO_MNT}/.github/workflows

mkdir -p "${workflows}"
for original in "${originals}"/workflows/*.yml; do
    name=$(basename "${original}" .yml)
    case " ${always} $* " in
        *" ${name} "*) ;;
        *) [[ -f ${workflows}/${name}.yml ]] || continue ;;
    esac
    cp "${original}" "${workflows}/${name}.yml"
    echo "Installed .github/workflows/${name}.yml"
done

for original in "${originals}"/actions/*/action.yml; do
    action=$(basename "$(dirname "${original}")")
    mkdir -p "${REPRO_MNT}/.github/actions/${action}"
    cp "${original}" "${REPRO_MNT}/.github/actions/${action}/action.yml"
    echo "Installed .github/actions/${action}/action.yml"
done
