#!/usr/bin/env bash
#
# Copies tro-checks' GitHub Actions workflows into the repository mounted at REPRO_MNT: the three every
# repository gets, and each optional one the repository already has or that is named, e.g.
#
#     install-tro-checks-gha make-candidates pull-candidates
#
# Overwrites earlier copies, so running it again is the upgrade; git shows what changed. Each copy
# records the tro-checks version it came from.

set -euo pipefail

always="preview-pasted-declaration preview-one-candidate update-reports"

read -r _ version install_dir < "${REPRO_INDEX_DIR}/tro-checks"
originals=${install_dir}/gha
workflows=${REPRO_MNT}/.github/workflows

mkdir -p "${workflows}"
for original in "${originals}"/workflows/*.yml; do
    name=$(basename "${original}" .yml)
    case " ${always} $* " in
        *" ${name} "*) ;;
        *) [[ -f ${workflows}/${name}.yml ]] || continue ;;
    esac
    sed "s/TRO_CHECKS_VERSION/${version}/" "${original}" > "${workflows}/${name}.yml"
    echo "Installed .github/workflows/${name}.yml"
done

if [[ -d ${originals}/actions ]]; then
    mkdir -p "${REPRO_MNT}/.github/actions"
    cp -r "${originals}/actions/." "${REPRO_MNT}/.github/actions/"
    echo "Installed .github/actions/"
fi
