{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/context-propagate-absent.schema.json",
    "title": "Context propagate absent",
    "description": "No @context limits which objects it applies to: @propagate appears nowhere within a context.",
    "summary": "The `@context` never uses `@propagate` to limit which objects it applies to",
    "$defs": {
        "contextValue": {
            "if": { "type": "object" },
            "then": {
                "not": { "required": ["@propagate"] },
                "errorMessage": { "not": "a context has no @propagate" },
                "additionalProperties": { "$ref": "#/$defs/contextValue" }
            },
            "else": {
                "if": { "type": "array" },
                "then": { "items": { "$ref": "#/$defs/contextValue" } }
            }
        },
        "node": {
            "if": { "type": "object" },
            "then": {
                "properties": { "@context": { "$ref": "#/$defs/contextValue" } },
                "additionalProperties": { "$ref": "#/$defs/node" }
            },
            "else": {
                "if": { "type": "array" },
                "then": { "items": { "$ref": "#/$defs/node" } }
            }
        }
    },
    "$ref": "#/$defs/node"
}
