{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/hash-values-correct-length.schema.json",
    "title": "Hash values correct length",
    "description": "Every trov:hash on the TRO's artifacts and composition fingerprint carries a value of its algorithm's length: 64 hexadecimal digits for sha256, sha3-256, blake2s and blake3; 96 for sha384 and sha3-384; 128 for sha512, sha3-512 and blake2b.",
    "summary": "Every hash value has the length its algorithm produces",
    "requires": [
        "hash-algorithms-permitted"
    ],
    "type": "object",
    "properties": {
        "@graph": {
            "type": "array",
            "items": {
                "if": {
                    "type": "object"
                },
                "then": {
                    "properties": {
                        "trov:hasComposition": {
                            "if": {
                                "type": "object"
                            },
                            "then": {
                                "properties": {
                                    "trov:hasArtifact": {
                                        "if": {
                                            "type": "array"
                                        },
                                        "then": {
                                            "items": {
                                                "if": {
                                                    "type": "object"
                                                },
                                                "then": {
                                                    "properties": {
                                                        "trov:hash": {
                                                            "if": {
                                                                "type": "array"
                                                            },
                                                            "then": {
                                                                "items": {
                                                                    "$ref": "#/$defs/hash"
                                                                }
                                                            },
                                                            "else": {
                                                                "$ref": "#/$defs/hash"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "trov:hasFingerprint": {
                                        "if": {
                                            "type": "object"
                                        },
                                        "then": {
                                            "properties": {
                                                "trov:hash": {
                                                    "$ref": "#/$defs/hash"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "hash": {
            "if": {
                "type": "object"
            },
            "then": {
                "allOf": [
                    {
                        "$ref": "#/$defs/sha256"
                    },
                    {
                        "$ref": "#/$defs/sha384"
                    },
                    {
                        "$ref": "#/$defs/sha512"
                    },
                    {
                        "$ref": "#/$defs/sha3-256"
                    },
                    {
                        "$ref": "#/$defs/sha3-384"
                    },
                    {
                        "$ref": "#/$defs/sha3-512"
                    },
                    {
                        "$ref": "#/$defs/blake2b"
                    },
                    {
                        "$ref": "#/$defs/blake2s"
                    },
                    {
                        "$ref": "#/$defs/blake3"
                    }
                ]
            }
        },
        "sha256": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "sha256"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "errorMessage": "a sha256 value is 64 hexadecimal digits"
                    }
                }
            }
        },
        "sha384": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "sha384"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 96,
                        "maxLength": 96,
                        "errorMessage": "a sha384 value is 96 hexadecimal digits"
                    }
                }
            }
        },
        "sha512": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "sha512"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 128,
                        "maxLength": 128,
                        "errorMessage": "a sha512 value is 128 hexadecimal digits"
                    }
                }
            }
        },
        "sha3-256": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "sha3-256"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "errorMessage": "a sha3-256 value is 64 hexadecimal digits"
                    }
                }
            }
        },
        "sha3-384": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "sha3-384"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 96,
                        "maxLength": 96,
                        "errorMessage": "a sha3-384 value is 96 hexadecimal digits"
                    }
                }
            }
        },
        "sha3-512": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "sha3-512"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 128,
                        "maxLength": 128,
                        "errorMessage": "a sha3-512 value is 128 hexadecimal digits"
                    }
                }
            }
        },
        "blake2b": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "blake2b"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 128,
                        "maxLength": 128,
                        "errorMessage": "a blake2b value is 128 hexadecimal digits"
                    }
                }
            }
        },
        "blake2s": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "blake2s"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "errorMessage": "a blake2s value is 64 hexadecimal digits"
                    }
                }
            }
        },
        "blake3": {
            "if": {
                "required": [
                    "trov:hashAlgorithm"
                ],
                "properties": {
                    "trov:hashAlgorithm": {
                        "const": "blake3"
                    }
                }
            },
            "then": {
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "errorMessage": "a blake3 value is 64 hexadecimal digits"
                    }
                }
            }
        }
    }
}
