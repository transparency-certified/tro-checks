{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/times-iso-8601.schema.json",
    "title": "Times ISO 8601",
    "description": "Every trov:startedAtTime and trov:endedAtTime is an ISO 8601 date-time, YYYY-MM-DDThh:mm:ss with an optional fraction of a second and an optional zone, wherever it appears; the TRO's schema:dateCreated, if present, is an ISO 8601 date or date-time, as schema.org defines it. A schema:dateCreated on any other node is not judged: it is schema.org used outside anything TROV specifies.",
    "summary": "Every `trov:startedAtTime` and `trov:endedAtTime` is an ISO 8601 date-time; the TRO's `schema:dateCreated`, if present, an ISO 8601 date or date-time",
    "requires": [
        "core-prefixes-pinned"
    ],
    "type": "object",
    "properties": {
        "@graph": {
            "allOf": [
                {
                    "$ref": "#/$defs/sweep"
                },
                {
                    "if": {
                        "type": "array"
                    },
                    "then": {
                        "items": {
                            "if": {
                                "type": "object",
                                "required": [
                                    "@type"
                                ],
                                "properties": {
                                    "@type": {
                                        "anyOf": [
                                            {
                                                "const": "trov:TransparentResearchObject"
                                            },
                                            {
                                                "type": "array",
                                                "contains": {
                                                    "const": "trov:TransparentResearchObject"
                                                }
                                            }
                                        ]
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "schema:dateCreated": {
                                        "type": "string",
                                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?)?$",
                                        "errorMessage": {
                                            "type": "schema:dateCreated is a string",
                                            "pattern": "schema:dateCreated is an ISO 8601 date (YYYY-MM-DD) or date-time (YYYY-MM-DDThh:mm:ss, optional fraction, optional zone)"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    },
    "$defs": {
        "sweep": {
            "allOf": [
                {
                    "if": {
                        "type": "object"
                    },
                    "then": {
                        "properties": {
                            "trov:startedAtTime": {
                                "$ref": "#/$defs/dateTime"
                            },
                            "trov:endedAtTime": {
                                "$ref": "#/$defs/dateTime"
                            }
                        },
                        "additionalProperties": {
                            "$ref": "#/$defs/sweep"
                        }
                    }
                },
                {
                    "if": {
                        "type": "array"
                    },
                    "then": {
                        "items": {
                            "$ref": "#/$defs/sweep"
                        }
                    }
                }
            ]
        },
        "dateTime": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$",
            "errorMessage": {
                "type": "a time is a string",
                "pattern": "a time is an ISO 8601 date-time: YYYY-MM-DDThh:mm:ss, optional fraction of a second, optional zone"
            }
        }
    }
}
