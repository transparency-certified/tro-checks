{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/hash-values-lowercase-hex.schema.json",
    "title": "Hash values lowercase hex",
    "description": "Every trov:hash on the TRO's artifacts and composition fingerprint carries its value in trov:hashValue, a string of lowercase hexadecimal digits and nothing else.",
    "summary": "Every hash carries its value as a string of lowercase hexadecimal digits",
    "requires": [
        "tro-top-level-in-graph"
    ],
    "type": "object",
    "properties": {
        "@graph": {
            "type": "array",
            "items": {
                "if": {
                    "type": "object"
                },
                "then": {
                    "properties": {
                        "trov:hasComposition": {
                            "if": {
                                "type": "object"
                            },
                            "then": {
                                "properties": {
                                    "trov:hasArtifact": {
                                        "if": {
                                            "type": "array"
                                        },
                                        "then": {
                                            "items": {
                                                "if": {
                                                    "type": "object"
                                                },
                                                "then": {
                                                    "properties": {
                                                        "trov:hash": {
                                                            "if": {
                                                                "type": "array"
                                                            },
                                                            "then": {
                                                                "items": {
                                                                    "$ref": "#/$defs/hash"
                                                                }
                                                            },
                                                            "else": {
                                                                "$ref": "#/$defs/hash"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "trov:hasFingerprint": {
                                        "if": {
                                            "type": "object"
                                        },
                                        "then": {
                                            "properties": {
                                                "trov:hash": {
                                                    "$ref": "#/$defs/hash"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "hash": {
            "if": {
                "type": "object"
            },
            "then": {
                "required": [
                    "trov:hashValue"
                ],
                "properties": {
                    "trov:hashValue": {
                        "type": "string",
                        "pattern": "^[0-9a-f]*$",
                        "errorMessage": {
                            "type": "a hash carries its value as a string",
                            "pattern": "a hash value is lowercase hexadecimal digits and nothing else"
                        }
                    }
                },
                "errorMessage": {
                    "required": "the hash carries no value (trov:hashValue)"
                }
            }
        }
    }
}
