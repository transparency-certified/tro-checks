{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/trace-spec-2026-04-19/context-protected-absent.schema.json",
    "title": "Context protected absent",
    "description": "No @context protects its terms against redefinition: @protected appears nowhere within a context.",
    "summary": "The `@context` never uses `@protected` to lock its entries against redefinition by a later context",
    "$defs": {
        "contextValue": {
            "if": { "type": "object" },
            "then": {
                "not": { "required": ["@protected"] },
                "errorMessage": { "not": "a context has no @protected" },
                "additionalProperties": { "$ref": "#/$defs/contextValue" }
            },
            "else": {
                "if": { "type": "array" },
                "then": { "items": { "$ref": "#/$defs/contextValue" } }
            }
        },
        "node": {
            "if": { "type": "object" },
            "then": {
                "properties": { "@context": { "$ref": "#/$defs/contextValue" } },
                "additionalProperties": { "$ref": "#/$defs/node" }
            },
            "else": {
                "if": { "type": "array" },
                "then": { "items": { "$ref": "#/$defs/node" } }
            }
        }
    },
    "$ref": "#/$defs/node"
}
