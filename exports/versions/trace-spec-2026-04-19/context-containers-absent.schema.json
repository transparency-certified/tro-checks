{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/trace-spec-2026-04-19/context-containers-absent.schema.json",
    "title": "Context containers absent",
    "description": "No @context declares a container: @container appears nowhere within a context, in any of its forms, @set included, although @set asks for no more than individual values.",
    "summary": "The `@context` never uses `@container` to tell a reader to interpret a property's array values as something other than individual values",
    "$defs": {
        "contextValue": {
            "if": { "type": "object" },
            "then": {
                "not": { "required": ["@container"] },
                "errorMessage": {
                    "not": "a term definition has no @container"
                },
                "additionalProperties": { "$ref": "#/$defs/contextValue" }
            },
            "else": {
                "if": { "type": "array" },
                "then": { "items": { "$ref": "#/$defs/contextValue" } }
            }
        },
        "node": {
            "if": { "type": "object" },
            "then": {
                "properties": { "@context": { "$ref": "#/$defs/contextValue" } },
                "additionalProperties": { "$ref": "#/$defs/node" }
            },
            "else": {
                "if": { "type": "array" },
                "then": { "items": { "$ref": "#/$defs/node" } }
            }
        }
    },
    "$ref": "#/$defs/node"
}
