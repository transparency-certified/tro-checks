[
    {
        "id": "SAFE-JSON",
        "description": "JSON that every supported parser reads the same way",
        "blocksHigherTiers": true,
        "expectations": [
            "utf8-encoded",
            "json-parses",
            "unicode-escapes-spell-whole-characters",
            "duplicate-member-names-absent",
            "numbers-within-range"
        ]
    },
    {
        "id": "SAFE-JSON-LD",
        "description": "JSON-LD that uses only those constructs our supported JSON-LD processors handle consistently, and whose interpretation depends on nothing outside the file",
        "blocksHigherTiers": true,
        "expectations": [
            "context-at-root-only",
            "remote-contexts-absent",
            "context-object-array-or-null",
            "context-containers-absent",
            "context-vocab-absent",
            "context-protected-absent",
            "context-propagate-absent",
            "context-import-absent",
            "context-id-coercion-absent",
            "graph-at-root-only",
            "graph-object-or-array",
            "ids-and-types-strings",
            "id-segments-portable"
        ]
    },
    {
        "id": "TRACE-PERMISSIBLE-JSON-LD",
        "description": "JSON-LD that avoids constructs and practices TRACE disallows",
        "blocksHigherTiers": true,
        "expectations": [
            "root-context-and-graph-only",
            "composite-contexts-absent",
            "disallowed-node-keywords-absent",
            "disallowed-context-keywords-absent",
            "base-web-scheme",
            "base-simple-url",
            "prefix-namespaces-terminated",
            "context-aliases-absent",
            "context-assigns-only-datatypes-to-properties",
            "context-datatypes-named-by-iri",
            "types-prefixed-or-absolute"
        ]
    },
    {
        "id": "USES-TROV-CORRECTLY",
        "description": "JSON-LD that uses TROV terms only in ways TRACE allows",
        "expectations": [
            "context-and-nonempty-graph-present",
            "core-prefixes-pinned",
            "trov-terms-known",
            "trov-version-known",
            "hash-algorithms-permitted",
            "hash-values-correct-form",
            "mime-types-two-part",
            "times-iso-8601",
            "times-zoned",
            "tro-name-description-text",
            "creators-person-or-organization",
            "trov-capabilities-predefined",
            "trov-performance-attributes-predefined",
            "trov-tro-attributes-predefined",
            "custom-terms-not-trov",
            "custom-term-superclasses-extensible",
            "trov-signing-mechanisms-predefined"
        ]
    },
    {
        "id": "DEFINES-TRS",
        "description": "JSON-LD that defines a Trusted Research System, identified by an absolute IRI",
        "expectations": [
            "trs-defined",
            "trs-id-absolute",
            "capability-terms-known"
        ]
    },
    {
        "id": "STANDALONE-TRO",
        "description": "A TRO declaration with the structure the TRACE Specification requires, whose references resolve within it",
        "expectations": [
            "tro-top-level-in-graph",
            "trov-objects-identified",
            "tro-assembled-by-trs",
            "performance-attribute-warrants-absolute",
            "tro-composition-single",
            "composition-has-fingerprint",
            "composition-identifies-artifacts",
            "artifact-hashes-present",
            "created-with-single-tool",
            "gpg-signing-key-present"
        ]
    },
    {
        "id": "LINKABLE-TRO",
        "description": "A TRO declaration whose element identifiers cannot collide with those in another TRO",
        "expectations": [
            "base-declared",
            "base-has-path",
            "base-host-lowercase",
            "base-host-ownable",
            "node-ids-present",
            "blank-node-ids-absent"
        ]
    }
]
