{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/times-zoned.schema.json",
    "title": "Times zoned",
    "description": "Every trov:startedAtTime and trov:endedAtTime carries its time zone: Z, or an offset of the form +hh:mm or -hh:mm.",
    "summary": "Every `trov:startedAtTime` and `trov:endedAtTime` carries its time zone",
    "requires": [
        "times-iso-8601"
    ],
    "type": "object",
    "properties": {
        "@graph": {
            "$ref": "#/$defs/sweep"
        }
    },
    "$defs": {
        "sweep": {
            "allOf": [
                {
                    "if": {
                        "type": "object"
                    },
                    "then": {
                        "properties": {
                            "trov:startedAtTime": {
                                "$ref": "#/$defs/zoned"
                            },
                            "trov:endedAtTime": {
                                "$ref": "#/$defs/zoned"
                            }
                        },
                        "additionalProperties": {
                            "$ref": "#/$defs/sweep"
                        }
                    }
                },
                {
                    "if": {
                        "type": "array"
                    },
                    "then": {
                        "items": {
                            "$ref": "#/$defs/sweep"
                        }
                    }
                }
            ]
        },
        "zoned": {
            "if": {
                "type": "string"
            },
            "then": {
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$",
                "errorMessage": {
                    "pattern": "a time carries its zone: Z, or an offset +hh:mm or -hh:mm"
                }
            }
        }
    }
}
