{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/capability-terms-known.schema.json",
    "title": "Capability terms known",
    "description": "Every value of trov:hasCapability is a reference to a capability term, {\"@id\": …} and nothing else, that TROV defines or that the TRS itself declares through its trov:customTerm. A term is named by a compact or absolute IRI, a TROV term with the trov: prefix, and a trov: term is one TROV defines. Whether a term in another namespace is one the TRS declares is not judged here.",
    "summary": "Every capability the TRS lists is a known term: one TROV defines or the TRS declares",
    "requires": [
        "core-prefixes-pinned",
        "trs-defined"
    ],
    "type": "object",
    "properties": {
        "@graph": {
            "$ref": "#/$defs/sweep"
        }
    },
    "$defs": {
        "sweep": {
            "allOf": [
                {
                    "if": {
                        "type": "object"
                    },
                    "then": {
                        "properties": {
                            "trov:hasCapability": {
                                "allOf": [
                                    {
                                        "if": {
                                            "type": "array"
                                        },
                                        "then": {
                                            "items": {
                                                "$ref": "#/$defs/value"
                                            }
                                        },
                                        "else": {
                                            "$ref": "#/$defs/value"
                                        }
                                    },
                                    {
                                        "$ref": "#/$defs/sweep"
                                    }
                                ]
                            }
                        },
                        "additionalProperties": {
                            "$ref": "#/$defs/sweep"
                        }
                    }
                },
                {
                    "if": {
                        "type": "array"
                    },
                    "then": {
                        "items": {
                            "$ref": "#/$defs/sweep"
                        }
                    }
                }
            ]
        },
        "value": {
            "type": "object",
            "required": [
                "@id"
            ],
            "additionalProperties": false,
            "errorMessage": {
                "type": "a capability is a reference to a capability term, {\"@id\": …}, not a string",
                "required": "a capability is a reference to a capability term, {\"@id\": …}",
                "additionalProperties": "a capability is a reference to a capability term, {\"@id\": …}, with nothing else in it"
            },
            "properties": {
                "@id": {
                    "allOf": [
                        {
                            "if": {
                                "type": "string"
                            },
                            "then": {
                                "pattern": "^(?!_:)[A-Za-z][A-Za-z0-9+.-]*:",
                                "errorMessage": {
                                    "pattern": "a capability term is named by a compact or absolute IRI, not by a relative id"
                                }
                            }
                        },
                        {
                            "if": {
                                "type": "string"
                            },
                            "then": {
                                "not": {
                                    "pattern": "^https://w3id\\.org/trace/trov/"
                                },
                                "errorMessage": {
                                    "not": "a TROV capability term is written with the trov: prefix"
                                }
                            }
                        },
                        {
                            "if": {
                                "type": "string",
                                "pattern": "^trov:"
                            },
                            "then": {
                                "enum": [
                                    "trov:CanProvideInternetIsolation",
                                    "trov:CanRecordInternetAccess",
                                    "trov:CanIsolateEnvironment",
                                    "trov:CanPreventAuthorIntervention",
                                    "trov:CanExcludeInputs",
                                    "trov:CanExcludeOutputs",
                                    "trov:CanEnsureInputDataIncludedInTROPackage",
                                    "trov:CanRequireInputDataExistsBeforeRun",
                                    "trov:CanRequireInputDataLocalBeforeRun",
                                    "trov:CanEnsureInputDataPersistsAfterRun",
                                    "trov:CanEnsureOutputDataIncludedInTROPackage",
                                    "trov:CanEnsureCodeIncludedInTROPackage",
                                    "trov:CanRecordSoftwareEnvironment",
                                    "trov:CanDetectInternetAccess",
                                    "trov:CanEnforceInternetIsolation",
                                    "trov:CanPreventUserInteractionDuringRun",
                                    "trov:CanEnforceCapabilitiesTechnically"
                                ],
                                "errorMessage": {
                                    "enum": "a trov: capability term is one TROV defines"
                                }
                            }
                        }
                    ]
                }
            }
        }
    }
}
