#!/usr/bin/env bash
#
# Writes reports/last-check.json in the repository mounted at REPRO_MNT: the tro-checks version the
# reports were made with, and one hash of the candidates and manifest, from the same hash-candidates
# script the regenerate-reports workflow runs to decide whether the reports are up to date.

set -euo pipefail

cd "${REPRO_MNT}"
read -r _ version install_dir < "${REPRO_INDEX_DIR}/tro-checks"
hash=$(bash "${install_dir}/gha/scripts/hash-candidates")
printf '{"tro-checks": "%s", "hash": "%s"}\n' "${version}" "${hash}" > reports/last-check.json
