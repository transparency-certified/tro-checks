#!/usr/bin/env bash
#
# Writes reports/last-check.json in the repository mounted at REPRO_MNT: when the reports were made,
# the tro-checks version they were made with, and one hash of the candidates and manifest. Workflow 3
# computes the same hash to decide whether the reports are up to date, so the two must stay the same.

set -euo pipefail

cd "${REPRO_MNT}"
read -r _ version _ < "${REPRO_INDEX_DIR}/tro-checks"
hash=$(LC_ALL=C sha256sum candidates/* | sha256sum | cut -d' ' -f1)
printf '{"time": "%s", "tro-checks": "%s", "hash": "%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${version}" "${hash}" > reports/last-check.json
