#!/usr/bin/env bash
#
# Writes reports/last-check.json in the repository mounted at REPRO_MNT: the tro-checks version the
# reports were made with, and one hash of the candidates and manifest. The regenerate-reports workflow computes the hash the
# same way to decide whether the reports are up to date.

set -euo pipefail

cd "${REPRO_MNT}"
read -r _ version _ < "${REPRO_INDEX_DIR}/tro-checks"
hash=$(LC_ALL=C sha256sum candidates/* | sha256sum | cut -d' ' -f1)
printf '{"tro-checks": "%s", "hash": "%s"}\n' "${version}" "${hash}" > reports/last-check.json
