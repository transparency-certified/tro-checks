{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/base-declared.schema.json",
    "title": "Base declared",
    "description": "The @context declares an @base.",
    "summary": "The `@context` includes an `@base`",
    "type": "object",
    "required": [
        "@context"
    ],
    "properties": {
        "@context": {
            "if": {
                "type": "array"
            },
            "then": {
                "contains": {
                    "type": "object",
                    "required": [
                        "@base"
                    ]
                },
                "errorMessage": {
                    "contains": "an @context declares an @base"
                }
            },
            "else": {
                "type": "object",
                "required": [
                    "@base"
                ],
                "errorMessage": {
                    "required": "an @context declares an @base"
                }
            }
        }
    },
    "errorMessage": {
        "required": "an @context declares an @base"
    }
}
