{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/base-declared.schema.json",
    "title": "Base declared",
    "description": "The @context declares an @base.",
    "summary": "The `@context` includes an `@base`",
    "type": "object",
    "required": ["@context"],
    "properties": {
        "@context": {
            "if": {
                "type": "array"
            },
            "then": {
                "contains": {
                    "type": "object",
                    "required": ["@base"]
                },
                "errorMessage": {
                    "contains": "no entry in the @context array declares an @base"
                }
            },
            "else": {
                "type": "object",
                "required": ["@base"],
                "errorMessage": {
                    "required": "the @context declares no @base"
                }
            }
        }
    },
    "errorMessage": {
        "required": "the declaration has no @context, so it can declare no @base"
    }
}
