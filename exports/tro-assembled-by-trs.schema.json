{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/tro-assembled-by-trs.schema.json",
    "title": "TRO assembled by TRS",
    "description": "The TRO names the system that assembled it, and that system is typed trov:TrustedResearchSystem.",
    "summary": "The TRO names its assembling system, typed as a TRS",
    "type": "object",
    "properties": {
        "@graph": {
            "type": "array",
            "items": {
                "if": {
                    "type": "object",
                    "required": ["@type"],
                    "properties": {
                        "@type": {
                            "anyOf": [
                                { "const": "trov:TransparentResearchObject" },
                                { "type": "array", "contains": { "const": "trov:TransparentResearchObject" } }
                            ]
                        }
                    }
                },
                "then": {
                    "required": ["trov:wasAssembledBy"],
                    "properties": {
                        "trov:wasAssembledBy": {
                            "type": "object",
                            "required": ["@type"],
                            "properties": {
                                "@type": {
                                    "if": { "type": "array" },
                                    "then": {
                                        "contains": { "const": "trov:TrustedResearchSystem" },
                                        "errorMessage": {
                                            "contains": "the assembling system's @type array does not include trov:TrustedResearchSystem"
                                        }
                                    },
                                    "else": {
                                        "const": "trov:TrustedResearchSystem",
                                        "errorMessage": {
                                            "const": "the assembling system is not typed trov:TrustedResearchSystem"
                                        }
                                    }
                                }
                            },
                            "errorMessage": {
                                "required": "the assembling system carries no @type"
                            }
                        }
                    },
                    "errorMessage": {
                        "required": "the TRO names no system that assembled it (trov:wasAssembledBy)"
                    }
                }
            }
        }
    }
}
