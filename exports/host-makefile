# Defines make targets for running tro-checks commands from outside the REPRO.
# Hooked up by this line in repro-config:
#
#     -include .tro-checks/host-makefile

## install-tro-checks-gha: Install tro-checks' GitHub Actions workflows, with any optional ones
##                    already present or named, e.g.
##                    make install-tro-checks-gha -- make-candidates pull-candidates.
.PHONY: install-tro-checks-gha
install-tro-checks-gha: session
	$(RUN_IN_REPRO) 'install-tro-checks-gha $(filter-out install-tro-checks-gha,$(MAKECMDGOALS))'

# Absorb the words after -- so make doesn't treat them as targets.
ifneq (,$(filter install-tro-checks-gha,$(MAKECMDGOALS)))
%:
	@:
endif
