{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/hashes-well-formed.schema.json",
    "title": "Hashes well-formed",
    "description": "Each trov:hash on the TRO's artifacts and composition fingerprint names sha256 as its algorithm and carries a value of 64 lowercase hexadecimal digits.",
    "summary": "The TRO's artifact and fingerprint hashes are well-formed sha256",
    "requires": ["tro-top-level-in-graph"],
    "type": "object",
    "properties": {
        "@graph": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "trov:hasComposition": {
                        "type": "object",
                        "properties": {
                            "trov:hasArtifact": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "trov:hash": { "$ref": "#/$defs/hash" }
                                    }
                                }
                            },
                            "trov:hasFingerprint": {
                                "type": "object",
                                "properties": {
                                    "trov:hash": { "$ref": "#/$defs/hash" }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "hash": {
            "type": "object",
            "required": ["trov:hashAlgorithm", "trov:hashValue"],
            "properties": {
                "trov:hashAlgorithm": {
                    "const": "sha256",
                    "errorMessage": {
                        "const": "the only hash algorithm this schema knows is sha256"
                    }
                },
                "trov:hashValue": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "errorMessage": {
                        "type": "a hash value is a string",
                        "pattern": "a sha256 value is 64 lowercase hexadecimal digits"
                    }
                }
            },
            "errorMessage": {
                "required": "a hash names an algorithm and carries a value"
            }
        }
    }
}
