{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/blank-node-ids-absent.schema.json",
    "title": "Blank node ids absent",
    "description": "Outside the @context, no @id is a blank node identifier. A blank node label is scoped to the document it appears in and any processor may rename it, so an element carrying one cannot be pointed at from outside -- the opposite of what this tier promises.",
    "summary": "No `@id` is a blank node identifier",
    "$defs": {
        "id": {
            "if": {
                "type": "string"
            },
            "then": {
                "not": {
                    "pattern": "^_:"
                },
                "errorMessage": {
                    "not": "an @id is not a blank node identifier"
                }
            }
        },
        "node": {
            "if": {
                "type": "object"
            },
            "then": {
                "properties": {
                    "@context": true,
                    "@id": {
                        "$ref": "#/$defs/id"
                    }
                },
                "additionalProperties": {
                    "$ref": "#/$defs/node"
                }
            },
            "else": {
                "if": {
                    "type": "array"
                },
                "then": {
                    "items": {
                        "$ref": "#/$defs/node"
                    }
                }
            }
        }
    },
    "$ref": "#/$defs/node"
}
