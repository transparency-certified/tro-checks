[
    {
        "id": "SAFE-JSON",
        "description": "JSON that every supported parser reads the same way",
        "expectations": [
            "utf8-encoded",
            "json-parses",
            "duplicate-member-names-absent",
            "lone-surrogates-absent",
            "numbers-within-range"
        ]
    },
    {
        "id": "SAFE-JSON-LD",
        "description": "JSON-LD that every supported processor reads the same way",
        "expectations": [
            "context-well-formed",
            "graph-well-formed",
            "ids-and-types-strings",
            "context-at-root-only",
            "containers-absent",
            "vocab-absent",
            "context-protection-absent",
            "id-coercion-absent",
            "graph-at-root-only",
            "id-segments-portable"
        ]
    },
    {
        "id": "TRACE-JSON-LD",
        "description": "JSON-LD in the restricted form the TRACE Specification requires for TRO declarations",
        "expectations": [
            "root-context-and-graph-only",
            "disallowed-node-keywords-absent",
            "disallowed-context-keywords-absent",
            "base-web-scheme",
            "base-simple-url",
            "prefix-namespaces-terminated",
            "context-local",
            "context-aliases-absent",
            "types-prefixed-or-absolute"
        ]
    },
    {
        "id": "STANDALONE-TRO",
        "description": "A TRO declaration with the structure the TRACE Specification requires, whose references resolve within it",
        "expectations": [
            "core-prefixes-pinned",
            "trov-terms-known",
            "tro-top-level-in-graph",
            "tro-assembled-by-trs",
            "composition-fingerprinted",
            "hashes-well-formed"
        ]
    },
    {
        "id": "LINKABLE-TRO",
        "description": "A TRO declaration whose element identifiers cannot collide with another TRO's",
        "expectations": [
            "base-declared",
            "base-has-path",
            "base-host-lowercase",
            "base-host-ownable",
            "node-ids-present",
            "blank-node-ids-absent"
        ]
    }
]
