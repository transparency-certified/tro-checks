[
    {
        "id": "SAFE-JSON",
        "description": "JSON that every parser reads the same way",
        "expectations": [
            "json-parses",
            "duplicate-member-names-absent"
        ]
    },
    {
        "id": "VALID-JSON-LD",
        "description": "Valid JSON-LD, whatever vocabulary it uses",
        "expectations": [
            "context-well-formed",
            "graph-well-formed",
            "ids-and-types-strings"
        ]
    },
    {
        "id": "TRACE-JSON-LD",
        "description": "JSON-LD in the restricted form the TRACE Specification defines for TRO declarations",
        "expectations": [
            "root-context-and-graph-only",
            "disallowed-node-keywords-absent",
            "disallowed-context-keywords-absent",
            "base-web-scheme",
            "base-simple-url",
            "relative-ids-plain",
            "prefix-namespaces-terminated"
        ]
    },
    {
        "id": "STANDALONE-TRO",
        "description": "A TRO declaration with the structure the Specification requires, whose references resolve within it",
        "expectations": [
            "trov-terms-known",
            "tro-top-level-in-graph",
            "tro-assembled-by-trs",
            "composition-fingerprinted",
            "hashes-well-formed"
        ]
    },
    {
        "id": "LINKABLE-TRO",
        "description": "A TRO declaration whose element identifiers cannot collide with another TRO's",
        "expectations": [
            "base-declared",
            "node-ids-present"
        ]
    }
]
