{
    "0": {
        "name": "Well-Formed",
        "description": "Valid JSON-LD conforming to the profile TRACE tooling expects",
        "expectations": [
            "context-well-formed",
            "graph-well-formed",
            "document-rooted-in-nodes",
            "disallowed-node-keywords-absent",
            "disallowed-context-keywords-absent",
            "ids-and-types-strings",
            "base-web-scheme",
            "base-simple-url",
            "relative-ids-plain",
            "prefix-namespaces-terminated"
        ]
    },
    "1": {
        "name": "Self-Contained",
        "description": "References within the TRO resolve; its identifiers need not be unique outside it",
        "expectations": [
            "composition-fingerprinted",
            "trov-terms-known",
            "hashes-well-formed",
            "context-and-graph-present",
            "tro-top-level-in-graph",
            "tro-assembled-by-trs"
        ]
    },
    "2": {
        "name": "Linkable-Data",
        "description": "Element identifiers cannot collide with another TRO's; TRO elements can be published",
        "expectations": [
            "base-declared",
            "node-ids-present"
        ]
    }
}
