{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/custom-term-superclasses-extensible.schema.json",
    "title": "Custom term superclasses extensible",
    "description": "Every rdfs:subClassOf in a trov:customTerm entry refers, by reference, to a TROV class open to extension: trov:TRSCapabilityType or trov:TRPAttributeType.",
    "summary": "Every custom term extends `trov:TRSCapabilityType` or `trov:TRPAttributeType`",
    "requires": [
        "core-prefixes-pinned"
    ],
    "type": "object",
    "properties": {
        "@graph": {
            "$ref": "#/$defs/sweep"
        }
    },
    "$defs": {
        "sweep": {
            "allOf": [
                {
                    "if": {
                        "type": "object"
                    },
                    "then": {
                        "properties": {
                            "trov:customTerm": {
                                "allOf": [
                                    {
                                        "if": {
                                            "type": "array"
                                        },
                                        "then": {
                                            "items": {
                                                "$ref": "#/$defs/value"
                                            }
                                        },
                                        "else": {
                                            "$ref": "#/$defs/value"
                                        }
                                    },
                                    {
                                        "$ref": "#/$defs/sweep"
                                    }
                                ]
                            }
                        },
                        "additionalProperties": {
                            "$ref": "#/$defs/sweep"
                        }
                    }
                },
                {
                    "if": {
                        "type": "array"
                    },
                    "then": {
                        "items": {
                            "$ref": "#/$defs/sweep"
                        }
                    }
                }
            ]
        },
        "value": {
            "if": {
                "type": "object"
            },
            "then": {
                "properties": {
                    "rdfs:subClassOf": {
                        "if": {
                            "type": "array"
                        },
                        "then": {
                            "items": {
                                "$ref": "#/$defs/superclass"
                            }
                        },
                        "else": {
                            "$ref": "#/$defs/superclass"
                        }
                    }
                }
            }
        },
        "superclass": {
            "type": "object",
            "errorMessage": {
                "type": "a custom term names its superclass by reference, {\"@id\": \u2026}, not as a string"
            },
            "properties": {
                "@id": {
                    "enum": [
                        "trov:TRSCapabilityType",
                        "trov:TRPAttributeType"
                    ],
                    "errorMessage": {
                        "enum": "a custom term extends a TROV class open to extension"
                    }
                }
            }
        }
    }
}
