{
    "@context": {
        "trov": "https://w3id.org/trace/trov/0.1#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "ex": "https://example.org/terms#"
    },
    "@graph": [
        {
            "@id": "tro",
            "@type": "trov:TransparentResearchObject",
            "trov:vocabularyVersion": "0.1",
            "trov:wasAssembledBy": {
                "@id": "https://trs.example.org/demo/"
            },
            "trov:hasPerformance": [
                {
                    "@id": "trp/0",
                    "@type": "trov:TrustedResearchPerformance",
                    "trov:wasConductedBy": {
                        "@id": "https://trs.example.org/demo/",
                        "@type": "trov:TrustedResearchSystem",
                        "trov:hasCapability": [
                            {
                                "@id": "https://trs.example.org/demo/capability/0",
                                "@type": "trov:CanProvideInternetIsolation"
                            }
                        ]
                    },
                    "trov:hasPerformanceAttribute": [
                        {
                            "@id": "trp/0/attribute/0",
                            "@type": "trov:InternetIsolation",
                            "trov:warrantedBy": {
                                "@id": "https://trs.example.org/demo/capability/0"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
